# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Allowed Origins (Comma-separated for multiple origins, e.g. production domain & staging)
# Trailing slashes are automatically normalized. Credentials (cookies/auth headers) are supported.
FRONTEND_URL=http://localhost:5173,http://localhost:3000

# Primary Database: Supabase PostgreSQL & Auth
SUPABASE_URL=https://[your-project-ref].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
# NEVER expose SUPABASE_SERVICE_ROLE_KEY to the frontend!
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# AI Microservice (Python / Flask with lsd_model.keras)
# Default: http://127.0.0.1:5050
AI_SERVICE_URL=http://127.0.0.1:5050
# Request timeout in milliseconds before triggering honest AI-unavailable response
AI_SERVICE_TIMEOUT=8000
# Optional custom Python executable path (defaults to python or .venv)
PYTHON_PATH=python

# Optional Agrometeorological AI (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Legacy / Optional Data Store (MongoDB is NOT required for production)
# If omitted or unavailable, backend automatically operates in Supabase PostgreSQL primary mode.
# MONGODB_URI=mongodb://127.0.0.1:27017/pashurakshak
